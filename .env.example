# ── LLM 프로바이더 선택 (서버 전용 — 클라이언트 노출 금지) ──
# anthropic(기본) | openai
LLM_PROVIDER=anthropic

# 프로바이더별 API 키
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 프로바이더별 모델 (미설정 시 기본값: claude-sonnet-5 / gpt-5.6-terra — 중간 티어)
# 최고 품질이 필요하면 claude-opus-5 / gpt-5.6-sol 로 변경
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-terra

# true면 API 키 없이 mock 데이터로 전체 플로우 테스트 가능
MOCK_MODE=true

# ── Phase 4: 인증 + 사용량 제한 ──
# Supabase (미설정 시 인증/횟수 제한 없이 개발 모드로 동작)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis rate limit (미설정 시 인메모리 폴백 — 배포 환경에선 필수)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (테스트용) 출력 토큰 상한 — 낮추면 저품질(잘림) 재현 가능
# MAX_OUTPUT_TOKENS=1000
